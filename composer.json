{
	"require": {
		"yahnis-elsts/plugin-update-checker": "^5.7"
	},
	"require-dev": {
		"squizlabs/php_codesniffer": "^3.13.6",
		"wp-coding-standards/wpcs": "^3.4.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.2",
		"phpcompatibility/phpcompatibility-wp": "^2.1.8",
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "^4.0"
	},
	"scripts": {
		"lint": "phpcs",
		"lint-fix": "phpcbf",
		"lint-all": "phpcs --standard=WordPress --extensions=php --ignore=*/vendor/*,*/node_modules/*,*/build/*,*/lib/* .",
		"lint-fix-all": "phpcbf --standard=WordPress --extensions=php --ignore=*/vendor/*,*/node_modules/*,*/build/*,*/lib/* .",
		"copy-puc": "rsync -a --delete vendor/yahnis-elsts/plugin-update-checker/ lib/plugin-update-checker/",
		"post-install-cmd": "@copy-puc",
		"post-update-cmd": "@copy-puc"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"platform": {
			"php": "8.0.2"
		}
	}
}
